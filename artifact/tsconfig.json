{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@/*": [
        "../src/*"
      ]
    },
    "plugins": []
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../src/**/*.ts",
    "../src/**/*.tsx",
    "vite.config.mts"
  ],
  "exclude": [
    "../src/app/api/**",
    "../src/proxy.ts",
    "../src/app/layout.tsx",
    "../src/app/admin/**"
  ]
}
